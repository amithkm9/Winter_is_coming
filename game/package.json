{
  "name": "learnsign-lost-signs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --max-old-space-size=4096 --experimental-strip-types --test tests/*.test.mjs",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test:winter-world": "node scripts/winter-world-smoke.mjs",
    "art:preview": "node scripts/render-art.mjs",
    "package:itch": "npm run build && node scripts/package-itch.mjs",
    "package:winter": "npm run build && node scripts/package-itch.mjs --winter"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "phaser": "3.90.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.14.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
