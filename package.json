{
  "name": "winter-is-coming",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mobile": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:winter-world": "node scripts/winter-world-smoke.mjs",
    "package:itch": "npm run build && python3 scripts/package_itch.py",
    "package:winter": "npm run package:itch"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.14.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "esbuild": "^0.28.2"
  }
}
