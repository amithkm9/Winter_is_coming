# Copy to backend/.env and start the service from the backend directory.
# Relative model paths are resolved from the working directory.
LEARNSIGN_MODEL_PATH=models/sign_language_numbers_letters.h5
LEARNSIGN_CONFIDENCE=0.85
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional companion services; keys remain on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=YTpq7expH9539ERJ
